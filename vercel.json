{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://mohamedkbany-portfolio.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/works",
      "destination": "/share-shells/works.html"
    },
    {
      "source": "/works/ai",
      "destination": "/share-shells/works-ai.html"
    },
    {
      "source": "/works/motion",
      "destination": "/share-shells/works-motion.html"
    },
    {
      "source": "/works/editing",
      "destination": "/share-shells/works-editing.html"
    },
    {
      "source": "/works/tv",
      "destination": "/share-shells/works-tv.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin-218405",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
